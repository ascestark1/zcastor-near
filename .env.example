# zcastor-near: the desk's own environment. Names only; fill values on your
# machine. setup.sh copies this to .env (gitignored, chmod 600).
#
# Every key here must be NEW, not copied from ~/zcastor-v2/.env.
# ops/check_isolation.py compares them by hash (never prints them) and refuses
# to start when one is shared.
#
# MT5 variables are deliberately absent. The desk never connects to the live
# MT5 account, and check_isolation.py refuses to start if any MT5_* is set.

# ── Hyperliquid ─────────────────────────────────────────────────────────────
# No key: the desk reads Hyperliquid's public data and fills on paper. Trading
# keys come later, issued and limited through NEAR, never pasted here by hand.
export HYPERLIQUID_TESTNET=false
export DESK_HUB_PORT=8170

# ── Anchoring: off until the desk has its own registries ────────────────────
export ANCHOR_BACKEND=null
export NVNM_ENV=l1-testnet
export NVNM_RPC_URL=https://rpc.nvnm.testnet.nvnmchain.io
export NVNM_CHAIN_ID=787223
# A NEW key. Sharing live's key makes both processes race for nonces.
export NVNM_PRIVATE_KEY=
# A NEW key. Followers trust the feed's signature; never sign desk events as live.
export ZCASTOR_FEED_KEY=

# Empty, or a separate desk channel. Never the live channel.
export DISCORD_WEBHOOK_URL=

export ZCASTOR_COMMIT=
export DESK_ENGINE_PORT=8100
export DESK_FEED_PORT=8190

# ── From 1 November (NEAR HACKATHON) ─────────────────────────────────────────
export NEAR_NETWORK=testnet
# The vault and its owner; agents are <name>.<owner>. See near/README.md.
export NEAR_VAULT=
export NEAR_OWNER=
# Mainnet account a failed NEAR Intents route would refund to (dry quotes only).
export NEAR_REFUND_ACCOUNT=
export NEAR_AI_MODEL=Qwen/Qwen3.8-27B
# No NEAR key goes here. The near CLI keeps testnet keys in its own keychain,
# and agents' EVM keys do not exist (NEAR Chain Signatures derives them).
export NEAR_AI_CLOUD_API_KEY=
# Optional. Without it 1-Click adds its unauthenticated fee.
export ONECLICK_JWT=
